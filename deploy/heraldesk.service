[Unit]
Description=Heraldesk autonomous social media department
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=heraldesk
Group=heraldesk
EnvironmentFile=/etc/heraldesk/heraldesk.env
ExecStart=/usr/local/bin/heraldesk serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/heraldesk
UMask=0077

[Install]
WantedBy=multi-user.target
